#!/usr/bin/env python3
"""agents-tui launcher: runs from a clone, or through a symlink to one."""

import os
import sys

if sys.version_info < (3, 9):
  sys.exit("agents-tui needs Python 3.9 or later (this is %d.%d)" % sys.version_info[:2])

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from agents_tui.cli import main  # noqa: E402

sys.exit(main())
